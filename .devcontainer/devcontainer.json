{
  "name": "songbook",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "TECTONIC_VERSION": "0.15.0"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb",
        "tamasfe.even-better-toml"
      ]
    }
  },
  "postCreateCommand": "cargo build && tectonic --version"
}
